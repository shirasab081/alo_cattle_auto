# Aloo Kisan Cattle Farm - Auto System - Male Voice
import asyncio
import edge_tts
import random
from datetime import datetime

# 100% Male Urdu Voice - Asad
VOICE = "ur-PK-AsadNeural"

# Aloo + Cattle Farm Kahaniyan
KAHANIYAN = [
    "Assalam o Alaikum! Main hun Aloo Kisan. Aaj subah maine apne cattle farm par gaaye ko taza chara khilaya. Meri gaaye ne khush ho kar doodh diya. Allah ka shukar hai.",
    "Aaj mere aloo ke khet me bohat achi fasal hui hai. Maine apne cattle farm ki khaad istemal ki thi. Desi khaad se aloo motay motay hue hain. Aloo aur gaaye ka rishta bohat purana hai.",
    "Aaj mere farm par ek choti bachri paida hui hai. Main bohat khush hun. Maine uska naam Rani rakha hai. Aloo Kisan ka farm din ba din taraqqi kar raha hai.",
    "Doston, cattle farm me safai bohat zaroori hai. Main roz subah apne baare ki safai karta hun. Saaf suthra farm, sehatmand janwar.",
    "Aaj maine apne aloo market beche aur us paise se apni gaayon ke liye naya chara laya. Yehi hai ek kisan ki zindagi."
]

async def banao_video():
    kahani = random.choice(KAHANIYAN)
    print(f"Aaj ki kahani: {kahani}")
    
    # Male Voice Banao
    communicate = edge_tts.Communicate(kahani, VOICE)
    await communicate.save("voice.mp3")
    
    # Kahani ko file me save karo taake video ban sake
    with open("kahani.txt", "w", encoding="utf-8") as f:
        f.write(kahani)
    
    print("Male voice ready! voice.mp3 ban gaya")

if __name__ == "__main__":
    asyncio.run(banao_video())
